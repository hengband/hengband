{
  "version": 1,
  "id": 31,
  "name": {
    "ja": "柳じじい",
    "en": "Old Man Willow Quest",
  },
  "definition": {
    "type": "KILL_ALL",
    "level": 22,
    "flags": ["PRESET", "ONCE"],
  },
  "descriptions": [
    {
      "when": {
        "statusAtMost": "COMPLETED",
      },
      "text": {
        "ja": [
          "『柳じじい』の行動は最近度が過ぎます！彼は森の一部を支配し、",
          "人間に敵対するようし向けました。柳じじいの森に行って全ての",
          "怪物を殺して下さい。充分な報酬を差し上げます。",
          "クエストは街の東の平地にあります。",
        ],
        "en": [
          "Old Man Willow has gone too far!  He has turned a small section",
          "of the forest against all men.  Kill everything you find in Old ",
          "Man Willow's section of the forest.  You will be well rewarded ",
          "for completing this quest.  The quest is in a clearing east of",
          "the town.",
        ],
      },
    },
    {
      "when": {
        "status": "REWARDED",
      },
      "text": {
        "ja": ["ありがとうございます！外にお礼が置いてあります。"],
        "en": ["Thank you!  Your reward is waiting outside."],
      },
    },
    {
      "when": {
        "status": "FAILED",
      },
      "text": {
        "ja": ["このクエストはあなたの手におえなかったようですね。他のを試して下さい。"],
        "en": ["The quest was more than you could handle.  Try another one.   "],
      },
    },
  ],
