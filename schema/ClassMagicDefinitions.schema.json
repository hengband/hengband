{
    "type": "object",
    "additionalProperties": false,
    "description": "職業に関する魔法の定義",
    "properties": {
        "version": {
            "const": 2,
            "description": "Version情報"
        },
        "aptitude_steps": {
            "type": "object",
            "description": "得意さの段階 1 つあたりの、職業別の値の動き",
            "additionalProperties": false,
            "required": [
                "learn_level_percent",
                "mana_cost_percent",
                "difficulty"
            ],
            "properties": {
                "learn_level_percent": {
                    "type": "integer",
                    "description": "習得レベルの動き。基準 × (50 − 基準) / 50 に対する百分率。整数0～100",
                    "minimum": 0,
                    "maximum": 100
                },
                "mana_cost_percent": {
                    "type": "integer",
                    "description": "消費MPの倍率の動き (百分率)。整数0～50",
                    "minimum": 0,
                    "maximum": 50
                },
                "difficulty": {
                    "type": "integer",
                    "description": "難易度の動き。整数0～20",
                    "minimum": 0,
                    "maximum": 20
                }
            }
        },
        "classes": {
            "type": "array",
            "description": "クラス別に魔法定義を格納する配列",
            "additionalProperties": false,
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "spell_type",
                    "magic_status",
                    "has_glove_mp_penalty",
                    "has_magic_fail_rate_cap",
                    "is_spell_trainable",
                    "armour_weight_limit",
                    "realms"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "職業名",
                        "additionalProperties": false,
                        "enum": [
                            "WARRIOR",
                            "MAGE",
                            "PRIEST",
                            "ROGUE",
                            "RANGER",
                            "PALADIN",
                            "WARRIOR_MAGE",
                            "CHAOS_WARRIOR",
                            "MONK",
                            "MINDCRAFTER",
                            "HIGH_MAGE",
                            "TOURIST",
                            "IMITATOR",
                            "BEASTMASTER",
                            "SORCERER",
                            "ARCHER",
                            "MAGIC_EATER",
                            "BARD",
                            "RED_MAGE",
                            "SAMURAI",
                            "FORCETRAINER",
                            "BLUE_MAGE",
                            "CAVALRY",
                            "BERSERKER",
                            "SMITH",
                            "MIRROR_MASTER",
                            "NINJA",
                            "SNIPER",
                            "ELEMENTALIST"
                        ]
                    },
                    "spell_type": {
                        "type": "string",
                        "description": "呪文書による呪文タイプ定義",
                        "additionalProperties": false,
                        "enum": [
                            "LIFE",
                            "SORCERY",
                            "MUSIC",
                            "HISSATSU",
                            "NONE"
                        ]
                    },
                    "magic_status": {
                        "type": "string",
                        "description": "魔法に使用するステータス",
                        "additionalProperties": false,
                        "enum": [
                            "STR",
                            "INT",
                            "WIS",
                            "DEX",
                            "CON",
                            "CHR"
                        ]
                    },
                    "has_glove_mp_penalty": {
                        "type": "boolean",
                        "description": "籠手装着によるMP減少ペナルティ"
                    },
                    "has_magic_fail_rate_cap": {
                        "type": "boolean",
                        "description": "呪文失敗率下限5%"
                    },
                    "is_spell_trainable": {
                        "type": "boolean",
                        "description": "呪文を訓練可能"
                    },
                    "first_spell_level": {
                        "type": "integer",
                        "description": "初めて呪文行使可能となるレベル。魔法を使わない職業は省略する",
                        "minimum": 0,
                        "maximum": 50
                    },
                    "armour_weight_limit": {
                        "type": "integer",
                        "description": "装備重量によるMP減少が開始する値。整数0～2047",
                        "minimum": 0,
                        "maximum": 2047
                    },
                    "realms": {
                        "type": "array",
                        "description": "各領域の得意さの段階と例外",
                        "items": {
                            "type": "object",
                            "description": "各領域の得意さの段階と例外。魔法ごとの値は、魔法の基準値 (SpellDefinitions) からこの段階で求める",
                            "additionalProperties": false,
                            "required": [
                                "name"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "description": "領域名",
                                    "enum": [
                                        "LIFE",
                                        "SORCERY",
                                        "NATURE",
                                        "CHAOS",
                                        "DEATH",
                                        "TRUMP",
                                        "ARCANE",
                                        "CRAFT",
                                        "DEMON",
                                        "CRUSADE"
                                    ]
                                },
                                "aptitude": {
                                    "type": "integer",
                                    "description": "得意さの段階。正が得意、負が不得意。省略時は0 (基準値のまま)。整数-9～9",
                                    "minimum": -9,
                                    "maximum": 9
                                },
                                "aptitude_as_second": {
                                    "type": "integer",
                                    "description": "第二領域として選んだときの段階。省略時は aptitude と同じ (aptitude と同じ値は書かない)。整数-9～9",
                                    "minimum": -9,
                                    "maximum": 9
                                },
                                "max_book": {
                                    "type": "integer",
                                    "description": "習得できる巻数。省略時は4 (省略と同じ4は書かない)。この巻より後ろの魔法書は使えず、その巻の魔法は習得できない (unlearnable にも overrides にも書かない)",
                                    "minimum": 1,
                                    "maximum": 4
                                },
                                "unlearnable": {
                                    "type": "array",
                                    "description": "習得できる巻にあるが習得できない魔法の呪文タグ",
                                    "uniqueItems": true,
                                    "items": {
                                        "type": "string",
                                        "description": "呪文タグ"
                                    }
                                },
                                "overrides": {
                                    "type": "array",
                                    "description": "領域の段階の代わりに別の段階を使う魔法。第一領域用・第二領域用の両方に効く。習得できない魔法には書かない",
                                    "items": {
                                        "type": "object",
                                        "description": "魔法ごとの段階",
                                        "additionalProperties": false,
                                        "required": [
                                            "spell_tag",
                                            "aptitude"
                                        ],
                                        "properties": {
                                            "spell_tag": {
                                                "type": "string",
                                                "description": "呪文タグ"
                                            },
                                            "aptitude": {
                                                "type": "integer",
                                                "description": "この魔法の得意さの段階。領域の段階 (第一・第二の両方) と同じ値は書かない。整数-9～9",
                                                "minimum": -9,
                                                "maximum": 9
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "required": [
        "version",
        "aptitude_steps",
        "classes"
    ]
}
