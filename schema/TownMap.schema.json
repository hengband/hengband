{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TownMap.schema.json",
  "title": "Town map definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "featureRules", "mapVariants", "buildingRules", "startingPositions"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 3
    },
    "notes": {
      "$ref": "#/$defs/commentLines"
    },
    "featureRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featureRule"
      }
    },
    "mapVariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapVariant"
      }
    },
    "buildingRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/buildingRule"
      }
    },
    "startingPositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/startPosition"
      }
    }
  },
  "$defs": {
    "commentLines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "featureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "definition"],
      "description": "Ordered terrain rule. Later matching rules override earlier rules for the same symbol.",
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1
        },
        "comments": {
          "$ref": "#/$defs/commentLines"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "pattern": "^(?![:/\\\\])[ -~]$"
        },
        "definition": {
          "$ref": "#/$defs/featureDefinition"
        }
      }
    },
    "featureDefinition": {
      "allOf": [
        {
          "$ref": "common/QuestGrid.schema.json#/$defs/gridDefinition"
        },
        {
          "properties": {
            "terrain": {
              "minLength": 1
            },
            "trap": {
              "minLength": 1,
              "not": {
                "const": "*"
              }
            },
            "ego": {
              "if": {
                "type": "object"
              },
              "then": {
                "not": {
                  "required": ["id"]
                }
              }
            }
          }
        }
      ]
    },
    "buildingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "locale", "command", "fields"],
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1
        },
        "comments": {
          "$ref": "#/$defs/commentLines"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "locale": {
          "enum": ["en", "ja"]
        },
        "command": {
          "enum": ["A", "C", "M", "N", "R", "Z"]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^:/\\x5c\\r\\n]*$"
          },
          "description": "Arguments in the selected building command's legacy order."
        }
      }
    },
    "mapVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1
        },
        "comments": {
          "$ref": "#/$defs/commentLines"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[ -~]+$"
          }
        }
      }
    },
    "startPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["y", "x"],
      "properties": {
        "when": {
          "type": "string",
          "minLength": 1
        },
        "comments": {
          "$ref": "#/$defs/commentLines"
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "x": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
