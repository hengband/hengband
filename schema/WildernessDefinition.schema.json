{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "width", "height", "towns", "maps"],
  "properties": {
    "version": { "const": 1 },
    "width": { "type": "integer", "minimum": 2, "maximum": 32767 },
    "height": { "type": "integer", "minimum": 2, "maximum": 32767 },
    "towns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/town" }
    },
    "maps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal", "compact"],
      "properties": {
        "normal": { "$ref": "#/definitions/map" },
        "compact": { "$ref": "#/definitions/map" }
      }
    }
  },
  "definitions": {
    "localized_string": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja", "en"],
      "properties": {
        "ja": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "localized_integer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja", "en"],
      "properties": {
        "ja": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "en": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "town": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 32767 },
        "name": { "$ref": "#/definitions/localized_string" },
        "alias": { "$ref": "#/definitions/localized_string" }
      }
    },
    "letter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "terrain"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1, "maxLength": 1, "pattern": "^[ -~]$" },
        "terrain": { "type": "integer", "minimum": 0, "maximum": 11 },
        "level": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            { "$ref": "#/definitions/localized_integer" }
          ]
        },
        "town": { "type": "integer", "minimum": 0, "maximum": 32767 },
        "road": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 1 },
        "y": { "type": "integer", "minimum": 1 }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["letters", "layout", "starting_position"],
      "properties": {
        "letters": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/letter" }
        },
        "layout": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "starting_position": { "$ref": "#/definitions/position" }
      }
    }
  }
}
