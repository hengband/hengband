{
    "type": "object",
    "additionalProperties": false,
    "description": "ベースアイテムの定義",
    "properties": {
        "version": {
            "const": 1,
            "description": "Version情報"
        },
        "baseitems": {
            "type": "array",
            "description": "ベースアイテム定義定義を格納する配列",
            "additionalProperties": false,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "symbol",
                    "itemkind",
                    "level",
                    "weight",
                    "cost"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32766
                    },
                    "name": {
                        "type": "object",
                        "description": "アイテム名",
                        "additionalProperties": false,
                        "required": [
                            "ja",
                            "en"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語アイテム名"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Item Name"
                            }
                        }
                    },
                    "flavor_name": {
                        "type": "object",
                        "description": "未鑑定アイテム名",
                        "additionalProperties": false,
                        "required": [
                            "ja",
                            "en"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語未鑑定アイテム名"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Unidentified Item Name"
                            }
                        }
                    },
                    "symbol": {
                        "type": "object",
                        "description": "表示される文字と色",
                        "additionalProperties": false,
                        "required": [
                            "character",
                            "color"
                        ],
                        "properties": {
                            "character": {
                                "type": "string",
                                "description": "表示される文字"
                            },
                            "color": {
                                "type": "string",
                                "description": "表示される色"
                            }
                        }
                    },
                    "itemkind": {
                        "type": "object",
                        "description": "ベースアイテム種別",
                        "additionalProperties": false,
                        "required": [
                            "type_value",
                            "subtype_value"
                        ],
                        "properties": {
                            "type_value": {
                                "type": "integer",
                                "description": "ベースアイテムカテゴリ。ItemKindType に定義された値のみ（C++ と CI で列挙子を検証）",
                                "minimum": 0,
                                "maximum": 127
                            },
                            "subtype_value": {
                                "type": "integer",
                                "description": "ベースアイテムタイプ",
                                "minimum": 0,
                                "maximum": 128
                            }
                        }
                    },
                    "parameter_value": {
                        "type": "integer",
                        "description": "種別ごとの値。装備 -128〜128、杖・魔法棒 1〜127、ロッド 1〜1000、食料 0〜10000、薬 -10000〜10000、油つぼ 1〜15000、箱 0〜63、その他 0。C++ の判定を正とする",
                        "minimum": -10000,
                        "maximum": 15000
                    },
                    "level": {
                        "type": "integer",
                        "description": "基本の生成階。発動の基本難易度などにも使う。たどり着ける最深の階 (MAX_DEPTH - 1) まで",
                        "minimum": 0,
                        "maximum": 127
                    },
                    "weight": {
                        "type": "integer",
                        "description": "重量",
                        "minimum": 0,
                        "maximum": 9999
                    },
                    "cost": {
                        "type": "integer",
                        "description": "売値。エゴと同じ INT_MAX / 32 以下、金貨は 1024 以下",
                        "minimum": 0,
                        "maximum": 67108863
                    },
                    "base_ac": {
                        "$comment": "maximum = ITEM_BASE_AC_MAX in src/info-reader/item-reader-limits.h (a small number from 0 to 255; sums over all equipment slots are estimated to stay within 16 bits up to about 1,000)",
                        "type": "integer",
                        "description": "ベースAC",
                        "minimum": 0,
                        "maximum": 255
                    },
                    "base_dice": {
                        "type": "string",
                        "description": "ダメージダイス XdY形式",
                        "pattern": "[0-9]*d[0-9]*"
                    },
                    "hit_bonus": {
                        "$comment": "range = +-ITEM_BONUS_MAX in src/info-reader/item-reader-limits.h (a small number with absolute value up to 255; sums over all equipment slots are estimated to stay within 16 bits up to about 1,000)",
                        "type": "integer",
                        "description": "命中補正値",
                        "minimum": -255,
                        "maximum": 255
                    },
                    "damage_bonus": {
                        "$comment": "range = +-ITEM_BONUS_MAX in src/info-reader/item-reader-limits.h (a small number with absolute value up to 255; sums over all equipment slots are estimated to stay within 16 bits up to about 1,000)",
                        "type": "integer",
                        "description": "ダメージ補正値",
                        "minimum": -255,
                        "maximum": 255
                    },
                    "ac_bonus": {
                        "$comment": "range = +-ITEM_BONUS_MAX in src/info-reader/item-reader-limits.h (a small number with absolute value up to 255; sums over all equipment slots are estimated to stay within 16 bits up to about 1,000)",
                        "type": "integer",
                        "description": "AC補正値",
                        "minimum": -255,
                        "maximum": 255
                    },
                    "allocations": {
                        "type": "array",
                        "description": "アイテム出現階層と希少度の定義",
                        "maxItems": 4,
                        "items": {
                            "type": "object",
                            "description": "出現階層と希少度の組",
                            "additionalProperties": false,
                            "required": [
                                "depth",
                                "rarity"
                            ],
                            "properties": {
                                "depth": {
                                    "type": "integer",
                                    "description": "出現階層",
                                    "minimum": 0,
                                    "maximum": 127
                                },
                                "rarity": {
                                    "$comment": "the generation weight is 100 / rarity (integer division), so 101 or more would be 0; 0 would be the same as no entry",
                                    "type": "integer",
                                    "description": "希少度。生成の重みは 100÷希少度 (整数の除算) で、1〜100 に限る。自然生成させないベースアイテムは natural_generation: false で表す",
                                    "minimum": 1,
                                    "maximum": 100
                                }
                            }
                        }
                    },
                    "natural_generation": {
                        "$comment": "false must not be combined with non-empty allocations (rejected by BaseitemReader and validate_json.py; the schema cannot express it)",
                        "type": "boolean",
                        "description": "生成テーブルによる自然生成 (床やモンスターのドロップなど) の対象か。省略時は true。false のベースアイテムは allocations を持たず、特定の経路 (店・特定のモンスターのドロップ・アーティファクトの本体など) でだけ作られる。false なら知識の一覧の候補になる"
                    },
