{
    "type": "object",
    "additionalProperties": false,
    "description": "MonsterRaceの定義",
    "properties": {
        "versions": {
            "const": 1,
            "description": "Version情報"
        },
        "monsters": {
            "type": "array",
            "description": "Monster定義を格納する配列",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "symbol",
                    "speed",
                    "hit_point",
                    "vision",
                    "armor_class",
                    "alertness",
                    "level",
                    "rarity",
                    "exp"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32766
                    },
                    "name": {
                        "type": "object",
                        "description": "モンスター名",
                        "additionalProperties": false,
                        "required": [
                            "ja",
                            "en"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語モンスター名"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Monster Name"
                            }
                        }
                    },
                    "symbol": {
                        "type": "object",
                        "description": "表示される文字と色",
                        "additionalProperties": false,
                        "required": [
                            "character",
                            "color"
                        ],
                        "properties": {
                            "character": {
                                "type": "string",
                                "description": "表示される文字",
                                "pattern": "^([a-zA-Z0-9!\/.!?#$%&()@,|*'`<>+{}=~\\[\\]]|\\\\)$"
                            },
                            "color": {
                                "type": "string",
                                "description": "表示される色",
                                "enum": [
                                    "Black",
                                    "White",
                                    "Gray",
                                    "Orange",
                                    "Red",
                                    "Green",
                                    "Blue",
                                    "Brown",
                                    "Dark Gray",
                                    "Light Gray",
                                    "Violet",
                                    "Yellow",
                                    "Light Red",
                                    "Light Green",
                                    "Light Blue",
                                    "Light Brown"
                                ]
                            }
                        }
                    },
                    "speed": {
                        "type": "integer",
                        "description": "加速。0を基準として-50～99",
                        "minimum": -50,
                        "maximum": 99
                    },
                    "hit_point": {
                        "type": "string",
                        "description": "体力。XdY形式",
                        "pattern": "^[1-9][0-9]*d[1-9][0-9]*$"
                    },
                    "vision": {
                        "type": "integer",
                        "description": "感知範囲。1マスあたり1",
                        "minimum": 0,
                        "maximum": 999
                    },
                    "armor_class": {
                        "$comment": "maximum = MONRACE_AC_MAX in src/info-reader/race-reader.cpp (GOEMON's AC is tripled in a 16-bit variable)",
                        "type": "integer",
                        "description": "物理防御力",
                        "minimum": 0,
                        "maximum": 10000
                    },
                    "alertness": {
                        "type": "integer",
                        "description": "警戒度。0=起きた状態で生成。高いほど起きにくい。",
                        "minimum": 0,
                        "maximum": 255
                    },
                    "level": {
                        "type": "integer",
                        "description": "出現階層",
                        "minimum": 0,
                        "maximum": 127
                    },
                    "rarity": {
                        "type": "integer",
                        "description": "出現頻度。高いほど出にくい",
                        "minimum": 1,
                        "maximum": 255
                    },
                    "exp": {
                        "type": "integer",
                        "description": "獲得経験値",
                        "minimum": 0,
                        "maximum": 9999999
                    },
                    "evolve": {
                        "type": "object",
                        "description": "進化情報",
                        "additionalProperties": false,
                        "required": [
                            "need_exp",
                            "to"
                        ],
                        "properties": {
                            "need_exp": {
                                "type": "integer",
                                "description": "進化に必要な経験値。0は進化しない値なので1以上とし、上限はexpと同じ9999999",
                                "minimum": 1,
                                "maximum": 9999999
                            },
                            "to": {
                                "type": "integer",
                                "description": "進化先モンスターID",
                                "minimum": 1,
                                "maximum": 32766
                            }
                        }
                    },
                    "sex": {
                        "type": "string",
                        "description": "性別",
                        "enum": [
                            "MALE",
                            "FEMALE"
                        ]
                    },
                    "odds_correction_ratio": {
                        "type": "integer",
                        "description": "闘技場オッズ補正値。100で等倍、200で2倍。補正は10倍あれば十分なので上限1000（同梱データの最大値900も含む）",
                        "minimum": 1,
                        "maximum": 1000
                    },
                    "start_hp_percentage": {
                        "type": "integer",
                        "description": "出現時体力。1-99%",
                        "minimum": 1,
                        "maximum": 99
                    },
                    "artifacts": {
                        "type": "array",
                        "description": "固定アーティファクトドロップリスト",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "drop_artifact_id",
                                "drop_probability"
                            ],
                            "properties": {
                                "drop_artifact_id": {
                                    "type": "integer",
                                    "description": "ドロップアーティファクトID",
                                    "minimum": 1,
                                    "maximum": 32766
                                },
                                "drop_probability": {
                                    "type": "integer",
                                    "description": "ドロップ率 1-100%",
                                    "minimum": 1,
                                    "maximum": 100
                                }
                            }
                        }
                    },
                    "escorts": {
                        "type": "array",
                        "description": "護衛リスト",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "escorts_id",
                                "escort_num"
                            ],
                            "properties": {
                                "escorts_id": {
                                    "type": "integer",
                                    "description": "護衛モンスターID",
                                    "minimum": 1,
                                    "maximum": 32766
                                },
                                "escort_num": {
                                    "type": "string",
                                    "description": "護衛生成数 XdY形式",
                                    "pattern": "^[1-9][0-9]*d[1-9][0-9]*$"
                                }
                            }
                        }
                    },
                    "blows": {
                        "type": "array",
                        "description": "物理攻撃",
                        "maxItems": 4,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "method",
                                "effect"
                            ],
                            "properties": {
                                "method": {
                                    "type": "string",
                                    "description": "打撃手段",
                                    "enum": [
                                        "HIT",
                                        "TOUCH",
                                        "PUNCH",
                                        "KICK",
                                        "CLAW",
                                        "BITE",
                                        "STING",
                                        "SLASH",
                                        "BUTT",
                                        "CRUSH",
                                        "ENGULF",
                                        "CHARGE",
                                        "CRAWL",
                                        "DROOL",
                                        "SPIT",
                                        "EXPLODE",
                                        "GAZE",
                                        "WAIL",
                                        "SPORE",
                                        "BEG",
                                        "INSULT",
                                        "MOAN",
                                        "SHOW",
                                        "DASH"
                                    ]
                                },
                                "effect": {
                                    "type": "string",
                                    "description": "打撃属性",
                                    "enum": [
                                        "HURT",
                                        "POISON",
                                        "UN_BONUS",
                                        "UN_POWER",
                                        "EAT_GOLD",
                                        "EAT_ITEM",
                                        "EAT_FOOD",
                                        "EAT_LITE",
                                        "ACID",
                                        "ELEC",
                                        "FIRE",
                                        "COLD",
                                        "BLIND",
                                        "CONFUSE",
                                        "TERRIFY",
                                        "PARALYZE",
                                        "LOSE_STR",
                                        "LOSE_INT",
                                        "LOSE_WIS",
                                        "LOSE_DEX",
                                        "LOSE_CON",
                                        "LOSE_CHR",
                                        "LOSE_ALL",
                                        "SHATTER",
                                        "EXP_10",
                                        "EXP_20",
                                        "EXP_40",
                                        "EXP_80",
                                        "DISEASE",
                                        "TIME",
                                        "EXP_VAMP",
                                        "DR_MANA",
                                        "SUPERHURT",
                                        "INERTIA",
                                        "STUN",
                                        "HUNGRY",
                                        "CHAOS",
                                        "FLAVOR"
                                    ]
                                },
                                "damage_dice": {
                                    "type": "string",
                                    "description": "ダメージダイス。XdY形式",
                                    "pattern": "^[1-9][0-9]*d[1-9][0-9]*$"
                                }
                            }
                        }
                    },
                    "flags": {
                        "type": "array",
                        "description": "モンスターフラグ",
                        "items": {
                            "$ref": "common/MonsterFlag.schema.json#/$defs/monsterFlag"
                        }
                    },
                    "skill": {
                        "type": "object",
                        "description": "発動型能力",
                        "additionalProperties": false,
                        "anyOf": [
                            {
                                "required": [
                                    "probability",
                                    "list"
                                ]
                            },
                            {
                                "required": [
                                    "probability",
                                    "shoot"
                                ]
                            },
                            {
                                "required": [
                                    "probability",
                                    "list",
                                    "shoot"
                                ]
                            }
                        ],
                        "properties": {
                            "probability": {
                                "type": "string",
                                "description": "能力使用確率",
                                "pattern": "^1_IN_([1-9][0-9]?|100)$"
                            },
                            "shoot": {
                                "type": "string",
                                "description": "射撃威力。XdY方式",
                                "pattern": "^[1-9][0-9]*d[1-9][0-9]*$"
                            },
                            "list": {
                                "type": "array",
                                "description": "発動型能力リスト",
                                "items": {
                                    "type": "string",
                                    "enum": [
                                        "SHRIEK",
                                        "DISPEL",
                                        "ROCKET",
                                        "BR_ACID",
                                        "BR_ELEC",
                                        "BR_FIRE",
                                        "BR_COLD",
                                        "BR_POIS",
                                        "BR_NETH",
                                        "BR_LITE",
                                        "BR_DARK",
                                        "BR_CONF",
                                        "BR_SOUN",
                                        "BR_CHAO",
                                        "BR_DISE",
                                        "BR_NEXU",
                                        "BR_TIME",
                                        "BR_INER",
                                        "BR_GRAV",
                                        "BR_SHAR",
                                        "BR_PLAS",
                                        "BR_FORC",
                                        "BR_MANA",
                                        "BA_NUKE",
                                        "BR_NUKE",
                                        "BA_CHAO",
                                        "BR_DISI",
                                        "BR_VOID",
                                        "BR_ABYSS",
                                        "BA_ACID",
                                        "BA_ELEC",
                                        "BA_FIRE",
                                        "BA_COLD",
                                        "BA_POIS",
                                        "BA_NETH",
                                        "BA_WATE",
                                        "BA_MANA",
                                        "BA_DARK",
                                        "BA_VOID",
                                        "BA_ABYSS",
                                        "BA_METEOR",
                                        "DRAIN_MANA",
                                        "MIND_BLAST",
                                        "BRAIN_SMASH",
                                        "CAUSE_1",
                                        "CAUSE_2",
                                        "CAUSE_3",
                                        "CAUSE_4",
                                        "BO_ACID",
                                        "BO_ELEC",
                                        "BO_FIRE",
                                        "BO_COLD",
                                        "BA_LITE",
                                        "BO_NETH",
                                        "BO_WATE",
                                        "BO_MANA",
                                        "BO_PLAS",
                                        "BO_ICEE",
                                        "BO_VOID",
                                        "BO_ABYSS",
                                        "BO_METEOR",
                                        "BO_LITE",
                                        "MISSILE",
                                        "SCARE",
                                        "BLIND",
                                        "CONF",
                                        "SLOW",
                                        "HOLD",
                                        "HASTE",
                                        "HAND_DOOM",
                                        "HEAL",
                                        "INVULNER",
                                        "BLINK",
                                        "TPORT",
                                        "WORLD",
                                        "SPECIAL",
                                        "TELE_TO",
                                        "TELE_AWAY",
                                        "TELE_LEVEL",
                                        "PSY_SPEAR",
                                        "DARKNESS",
                                        "TRAPS",
                                        "FORGET",
                                        "ANIM_DEAD",
                                        "S_KIN",
                                        "S_CYBER",
                                        "S_MONSTER",
                                        "S_MONSTERS",
                                        "S_ANT",
                                        "S_SPIDER",
                                        "S_HOUND",
                                        "S_HYDRA",
                                        "S_ANGEL",
                                        "S_DEMON",
                                        "S_UNDEAD",
                                        "S_DRAGON",
                                        "S_HI_UNDEAD",
                                        "S_HI_DRAGON",
                                        "S_AMBERITES",
                                        "S_UNIQUE",
                                        "S_DEAD_UNIQUE"
                                    ]
                                }
                            }
                        }
                    },
                    "flavor": {
                        "type": "object",
                        "description": "フレーバーテキスト",
                        "additionalProperties": false,
                        "required": [
                            "ja"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語フレーバーテキスト"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Flavor Text"
                            }
                        }
                    },
                    "final_summon": {
                        "type": "array",
                        "description": "死亡時召喚",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "probability",
                                "min_num",
                                "max_num",
                                "radius"
                            ],
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "description": "召喚するモンスターID",
                                    "minimum": 1,
                                    "maximum": 32766
                                },
                                "probability": {
                                    "type": "integer",
                                    "description": "召喚する確率。probability/100で召喚する。",
                                    "minimum": 1,
                                    "maximum": 100
                                },
                                "min_num": {
                                    "type": "integer",
                                    "description": "召喚数の下限",
                                    "minimum": 0,
                                    "maximum": 99
                                },
                                "max_num": {
                                    "type": "integer",
                                    "description": "召喚数の上限",
                                    "minimum": 1,
                                    "maximum": 99
                                },
                                "radius": {
                                    "type": "integer",
                                    "description": "召喚先の距離",
                                    "minimum": 1,
                                    "maximum": 20
                                }
                            }
                        }
                    },
                    "message": {
                        "type": "array",
                        "description": "メッセージ",
                        "items": {
                            "type": "object",
                            "maxItems": 3,
                            "additionalProperties": false,
                            "required": [
                                "action",
                                "chance",
                                "message"
                            ],
                            "properties": {
                                "action": {
                                    "type": "string",
                                    "description": "メッセージトリガーとなる行動",
                                    "enum": [
                                        "SPEAK_ALL",
                                        "SPEAK_BATTLE",
                                        "SPEAK_FEAR",
                                        "SPEAK_FRIEND",
                                        "SPEAK_DEATH",
                                        "SPEAK_SPAWN",
                                        "WALK_CLOSERANGE",
                                        "WALK_MIDDLERANGE",
                                        "WALK_LONGRANGE",
                                        "MESSAGE_STALKER",
                                        "MESSAGE_REFLECT",
                                        "MESSAGE_TIMESTOP",
                                        "MESSAGE_TIMESTART",
                                        "MESSAGE_BREATH_SOUND",
                                        "MESSAGE_BREATH_SHARDS",
                                        "MESSAGE_BREATH_FORCE",
                                        "MESSAGE_BREATH_LITE",
                                        "MESSAGE_DETECT_UNIQUE"
                                    ]
                                },
                                "chance": {
                                    "type": "integer",
                                    "description": "メッセージ発生率。1/chanceで機能する。",
                                    "minimum": 1,
                                    "maximum": 100
                                },
                                "use_name": {
                                    "type": "boolean",
                                    "description": "メッセージの先頭にモンスター名を表示する。"
                                },
                                "message": {
                                    "type": "object",
                                    "description": "メッセージ",
                                    "additionalProperties": false,
                                    "required": [
                                        "ja"
                                    ],
                                    "properties": {
                                        "ja": {
                                            "type": "string",
                                            "description": "日本語メッセージ"
                                        },
                                        "en": {
                                            "type": "string",
                                            "description": "English Message"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "required": [
        "versions",
        "monsters"
    ]
}