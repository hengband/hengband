{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TownDefinitionList.schema.json",
  "title": "Town map files by town and wilderness mode",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "towns"],
  "properties": {
    "version": { "const": 1 },
    "towns": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[1-9][0-9]*$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/mapFile" },
          {
            "type": "object",
            "required": ["lite", "normal", "none"],
            "additionalProperties": false,
            "properties": {
              "lite": { "$ref": "#/$defs/mapFile" },
              "normal": { "$ref": "#/$defs/mapFile" },
              "none": { "$ref": "#/$defs/mapFile" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "mapFile": { "type": "string", "pattern": "^towns/[A-Za-z0-9_]+\\.txt$" }
  }
}
