    "dungeon": {
      "type": "object",
      "additionalProperties": false,
      "if": {
        "properties": {
          "id": {
            "not": {
              "const": 0
            }
          }
        }
      },
      "then": {
        "properties": {
          "position": {
            "$ref": "#/$defs/entrancePosition"
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "position",
        "generation",
        "monsters",
        "floor",
        "wall",
        "flags"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "name": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "monsters": {
          "$ref": "#/$defs/monsters"
        },
        "floor": {
          "$ref": "#/$defs/floor"
        },
        "final_floor": {
          "$ref": "#/$defs/final_floor"
        },
        "wall": {
          "$ref": "#/$defs/wall"
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dungeonFlag"
          }
        }
      }
    },
    "pitKind": {
      "type": "string",
      "enum": [
        "CHAPEL",
        "DARK_ELF",
        "DEMON",
        "DRAGON",
        "GIANT",
        "HORROR",
        "ORC",
        "SYMBOL_EVIL",
        "SYMBOL_GOOD",
        "TROLL"
      ]
    },
    "nestKind": {
      "type": "string",
      "enum": [
        "CLONE",
        "JELLY",
        "SYMBOL_GOOD",
        "SYMBOL_EVIL",
        "MIMIC",
        "HORROR",
        "KENNEL",
        "ANIMAL",
        "CHAPEL",
        "UNDEAD"
      ]
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "count", "chance", "priority"],
      "properties": {
        "type": {
          "$ref": "#/$defs/wallTerrain"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "chance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    }
  }
}
