{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vault definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["vaults"],
  "properties": {
    "vaults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "rating", "height", "width", "layout"],
        "properties": {
          "id": { "type": "integer", "minimum": 0, "maximum": 32766 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "integer", "enum": [7, 8, 17] },
          "rating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "description": "未使用。読み込んで保持するだけで、ゲーム中では参照しない。"
          },
          "height": { "type": "integer", "minimum": 1, "maximum": 66 },
          "width": { "type": "integer", "minimum": 1, "maximum": 198 },
          "layout": {
            "type": "array",
            "minItems": 1,
            "maxItems": 66,
            "items": { "type": "string", "minLength": 1, "maxLength": 198, "pattern": "^[ -~]+$" }
          }
        }
      }
    }
  }
}
