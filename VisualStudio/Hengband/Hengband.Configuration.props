<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <HengbandDebugBuild Condition="$(Configuration.EndsWith('Debug'))">true</HengbandDebugBuild>
    <HengbandJapanese Condition="!$(Configuration.StartsWith('English'))">true</HengbandJapanese>
  </PropertyGroup>
  <!--
    日本語版の内部の文字コードは、既定では UTF-8 にする (Issue #6140)。
    移行を終えるまでは、/p:HengbandUtf8Internal=false で Shift_JIS の構成も選べる (英語版では無視する)。
    Shift_JIS の構成の中間ファイルとテストの出力先は、既定の構成と混ざらないよう「構成名-SJIS」に分ける。
  -->
  <PropertyGroup Label="UserMacros">
    <HengbandUtf8Build Condition="'$(HengbandJapanese)'=='true' and '$(HengbandUtf8Internal)'!='false'">true</HengbandUtf8Build>
    <HengbandSjisBuild Condition="'$(HengbandJapanese)'=='true' and '$(HengbandUtf8Build)'!='true'">true</HengbandSjisBuild>
    <HengbandJapaneseEncoding Condition="'$(HengbandUtf8Build)'=='true'">UTF8</HengbandJapaneseEncoding>
    <HengbandJapaneseEncoding Condition="'$(HengbandUtf8Build)'!='true'">SJIS</HengbandJapaneseEncoding>
    <HengbandExecutionCharset Condition="'$(HengbandUtf8Build)'=='true'">utf-8</HengbandExecutionCharset>
    <HengbandExecutionCharset Condition="'$(HengbandUtf8Build)'!='true'">shift-jis</HengbandExecutionCharset>
    <HengbandConfigurationDir>$(Configuration)</HengbandConfigurationDir>
    <HengbandConfigurationDir Condition="'$(HengbandSjisBuild)'=='true'">$(Configuration)-SJIS</HengbandConfigurationDir>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization Condition="'$(HengbandDebugBuild)'!='true'">true</WholeProgramOptimization>
    <UseDebugLibraries Condition="'$(HengbandDebugBuild)'=='true'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(HengbandDebugBuild)'!='true'">false</UseDebugLibraries>
  </PropertyGroup>
</Project>
